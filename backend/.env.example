# Pooled connection (Supabase transaction pooler, port 6543, add ?pgbouncer=true)
DATABASE_URL=
# Direct connection used by migrations (Supabase session pooler, port 5432)
DIRECT_URL=
# Supabase Auth: the backend verifies Supabase access tokens with these
SUPABASE_URL=
SUPABASE_JWKS_URL=
# Server-only key for Storage uploads (never expose to the frontend)
SUPABASE_SECRET_KEY=
PORT=3001
# Comma-separated list of allowed frontend origins
FRONTEND_URL=http://localhost:3000
NODE_ENV=development
# Server-side scraping (Playwright). Off by default.
SCRAPERS_ENABLED=false
