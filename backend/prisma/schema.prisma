generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -- User Data (Custom Auth) --
model UserProfile {
  id           String   @id @default(uuid())
  email        String   @unique
  username     String   @unique
  passwordHash String
  name         String?
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  // Relations
  hooks          Hook[]
  competitors    Competitor[]
  socialAccounts SocialAccount[]
  scriptTemplates ScriptTemplate[]
  scripts        Script[]
  automations    Automation[]
}

// -- Library (Hooks & Scripts) --
model Hook {
  id                String   @id @default(uuid())
  content           String
  type              String   // Verbal, Visual
  emotion           String
  topic             String
  performanceRating Int?     // 1-5
  
  // Usage Tracking
  usageCount        Int      @default(0)
  views             Int      @default(0)
  lastUsed          DateTime?
  
  tags              String[] @default([])
  sourceMetadata    Json?    // { url: string, title: string, thumbnail: string, handle: string }
  
  userId            String
  user              UserProfile @relation(fields: [userId], references: [id])
  
  socialAccountId   String?
  socialAccount     SocialAccount? @relation(fields: [socialAccountId], references: [id])
  
  // Relations
  scriptTemplates   ScriptTemplate[]
  userPosts         UserPost[]
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model ScriptTemplate {
  id        String   @id @default(uuid())
  title     String
  content   Json     // Structure details (array of steps)
  category  String
  status    String   @default("Draft")
  excerpt   String?
  wordCount Int?     @default(0)
  views     Int      @default(0)
  tags      String[] @default([])
  sourceMetadata Json?  // { url: string, title: string, thumbnail: string, handle: string }
  
  userId    String
  user      UserProfile @relation(fields: [userId], references: [id])
  
  hookId    String?
  hook      Hook?       @relation(fields: [hookId], references: [id])
  
  // Relations
  scripts   Script[]    // Scripts created using this template
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Script {
  id        String   @id @default(uuid())
  title     String
  content   Json     // The actual script content
  category  String
  status    String   @default("Draft") // Draft, Completed
  excerpt   String?
  wordCount Int?     @default(0)

  // Optional link to a template/blueprint
  templateId String?
  template   ScriptTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  userId    String
  user      UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// -- Competitor Tracking --
model Competitor {
  id        String   @id @default(uuid())
  handle    String
  name      String
  avatarUrl String
  bio       String?
  tags      String[]
  
  // Snapshots of their stats
  stats     Json     // { followers: string, avgLikes: string, engagementRate: string }
  
  userId    String
  user      UserProfile @relation(fields: [userId], references: [id])
  
  socialAccountId String?
  socialAccount   SocialAccount? @relation(fields: [socialAccountId], references: [id])
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  posts     CompetitorPost[]
  
  @@unique([userId, handle]) // User can't track same competitor twice
}

// -- Viral Posts Analysis --
model CompetitorPost {
  id             String   @id @default(uuid())
  competitorId   String
  competitor     Competitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)
  
  thumbnailUrl   String
  captionExcerpt String
  postedAt       DateTime
  
  metrics        Json     // { likes: number, comments: number }
  isViral        Boolean  @default(false)
  
  // Analysis Data
  analysis       Json?    // { hook: string, structure: string, notes: string }
  
  createdAt      DateTime @default(now())
}

// -- My Performance --
model UserPost {
  id              String   @id @default(uuid())
  externalId      String?  // Platform ID
  thumbnailUrl    String?
  caption         String?
  postedAt        DateTime
  
  metrics         Json     // { likes: number, comments: number, views: number, etc. }
  
  socialAccountId String
  socialAccount   SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)
  
  hookId          String?
  hook            Hook?    @relation(fields: [hookId], references: [id])
  
  createdAt       DateTime @default(now())
}

// -- Community & Followers --
model Follower {
  id              String   @id @default(uuid())
  handle          String
  name            String?
  avatarUrl       String?
  segment         String   // VIP, Superfan, New, etc.
  
  stats           Json     // { totalLikes: number, totalComments: number, lastActive: DateTime }
  
  socialAccountId String
  socialAccount   SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)
  
  interactions    Interaction[]
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([socialAccountId, handle])
}

model Interaction {
  id          String   @id @default(uuid())
  followerId  String
  follower    Follower @relation(fields: [followerId], references: [id], onDelete: Cascade)
  
  type        String   // LIKE, COMMENT, STORY_REPLY
  content     String?  // Comment text
  timestamp   DateTime @default(now())
  
  createdAt   DateTime @default(now())
}

// -- Social Account Management --
model SocialAccount {
  id          String   @id @default(uuid())
  userId      String
  user        UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  platform    String   // 'instagram', 'tiktok', 'youtube', etc.
  username    String
  accountId   String   // Platform-specific ID
  avatarUrl   String?
  
  // OAuth / API Credentials
  accessToken String?  // Store encrypted in production
  refreshToken String?
  tokenExpiry DateTime?
  
  // Account Status
  isActive    Boolean  @default(false) // Currently selected account
  isConnected Boolean  @default(true)  // Connection is valid
  
  // Relations
  hooks       Hook[]
  competitors Competitor[]
  userPosts   UserPost[]
  followers   Follower[]
  automations Automation[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@unique([userId, platform, accountId]) // One user can't connect same account twice
}

// -- Automations & Keyword Triggers --
model Automation {
  id              String   @id @default(uuid())
  name            String
  triggerKeyword  String
  responseMessage String
  platform        String?  // 'instagram', 'tiktok', etc.
  active          Boolean  @default(true)
  
  // Monitoring & Stats
  runCount        Int      @default(0)
  lastRunAt       DateTime?
  
  // Multi-Action Support
  commentReplyEnabled Boolean @default(false)
  commentReplyMessage String?
  
  // Instagram Specific
  instagramPostId String?
  isGlobal        Boolean @default(true)
  
  userId          String
  user            UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  socialAccountId String?
  socialAccount   SocialAccount? @relation(fields: [socialAccountId], references: [id], onDelete: SetNull)
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
