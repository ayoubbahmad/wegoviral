generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Direct (non-pooled) connection, used by migrations
  directUrl = env("DIRECT_URL")
}

model UserProfile {
  id                   String              @id @default(uuid())
  email                String              @unique
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  avatarUrl            String?
  name                 String?
  passwordHash         String? // Unused since Supabase Auth; kept nullable for old rows
  authUserId           String?             @unique // Supabase Auth user id (JWT "sub")
  username             String              @unique
  role                 UserRole            @default(MEMBER)
  // Restrictions: MUTED can read but not interact; SUSPENDED and BANNED can't use the community
  status               MemberStatus        @default(ACTIVE)
  statusReason         String?
  statusUntil          DateTime? // null = until lifted by staff
  // Joining: application → approval → rules acceptance (see docs/ADMIN_ROADMAP.md, Phase 2)
  joinStatus           JoinStatus          @default(PENDING)
  phone                String?
  specialMember        Boolean             @default(false) // skips approval, the guide and probation
  referralCode         String?             @unique
  referredById         String?
  referredBy           UserProfile?        @relation("Referrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals            UserProfile[]       @relation("Referrals")
  rulesAcceptedVersion Int?
  rulesAcceptedAt      DateTime?
  quizPassedVersion    Int?
  // Set once enough reviewed posts were approved (or for members who joined before review existed)
  probationCompletedAt DateTime?
  // Membership tier (null = the default tier). Set by hand until Stripe (Phase 9)
  tierId               String?
  // All-time points (sum of the points ledger); levels are derived from it
  points               Int                 @default(0)
  tier                 MembershipTier?     @relation(fields: [tierId], references: [id], onDelete: SetNull)
  automations          Automation[]
  competitors          Competitor[]
  creators             Creator[]
  hooks                Hook[]
  scripts              Script[]
  scriptTemplates      ScriptTemplate[]
  socialAccounts       SocialAccount[]
  watchlists           Watchlist[]
  projects             Project[]
  communityPosts       CommunityPost[]
  communityComments    CommunityComment[]
  communityLikes       CommunityPostLike[]
  communityBookmarks   CommunityBookmark[]
  communityVotes       CommunityPollVote[]
  adminActivity        AdminActivity[]
  application          MemberApplication?  @relation("Applicant")
  reviewedApplications MemberApplication[] @relation("ApplicationReviewer")
  rulesAcceptances     RulesAcceptance[]
  createdInvites       InviteLink[]
  reviewedPosts        CommunityPost[]     @relation("PostReviewer")
  reports              ContentReport[]     @relation("Reporter")
  resolvedReports      ContentReport[]     @relation("ReportResolver")
  warnings             MemberWarning[]     @relation("WarnedMember")
  issuedWarnings       MemberWarning[]     @relation("WarningIssuer")
  hostedEvents         CommunityEvent[]    @relation("EventHost")
  ownedCourses         Course[]            @relation("CourseOwner")
  courseEnrollments    CourseEnrollment[]
  lessonProgress       LessonProgress[]
  eventRsvps           EventRsvp[]
  pointEvents          PointEvent[]
  badges               MemberBadge[]       @relation("BadgeHolder")
  awardedBadges        MemberBadge[]       @relation("BadgeAwarder")
}

model Hook {
  id                String           @id @default(uuid())
  content           String
  type              String
  emotion           String
  topic             String
  performanceRating Int?
  usageCount        Int              @default(0)
  lastUsed          DateTime?
  userId            String
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  socialAccountId   String?
  sourceMetadata    Json?
  tags              String[]         @default([])
  views             Int              @default(0)
  sourceUrl         String?
  socialAccount     SocialAccount?   @relation(fields: [socialAccountId], references: [id])
  user              UserProfile      @relation(fields: [userId], references: [id])
  scriptTemplates   ScriptTemplate[]
  userPosts         UserPost[]
}

model ScriptTemplate {
  id             String      @id @default(uuid())
  title          String
  content        Json
  category       String
  userId         String
  hookId         String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  excerpt        String?
  status         String      @default("Draft")
  wordCount      Int?        @default(0)
  sourceMetadata Json?
  tags           String[]    @default([])
  views          Int         @default(0)
  sourceUrl      String?
  scripts        Script[]
  hook           Hook?       @relation(fields: [hookId], references: [id])
  user           UserProfile @relation(fields: [userId], references: [id])
}

model Script {
  id         String          @id @default(uuid())
  title      String
  content    Json
  category   String
  status     String          @default("Draft")
  excerpt    String?
  wordCount  Int?            @default(0)
  templateId String?
  userId     String
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  template   ScriptTemplate? @relation(fields: [templateId], references: [id])
  user       UserProfile     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Competitor {
  id              String           @id @default(uuid())
  handle          String // Standardized username
  name            String
  avatarUrl       String
  bio             String?
  tags            String[]
  stats           Json
  platform        String // e.g., "youtube", "tiktok", "instagram"
  externalUrl     String // Link to the creator's profile
  originUrl       String? // The URL used to initiate the scrape
  userId          String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  socialAccountId String?
  creatorId       String?
  creator         Creator?         @relation(fields: [creatorId], references: [id])
  socialAccount   SocialAccount?   @relation(fields: [socialAccountId], references: [id])
  user            UserProfile      @relation(fields: [userId], references: [id])
  posts           CompetitorPost[]
  watchlists      Watchlist[]      @relation("CompetitorToWatchlist")

  @@unique([userId, handle])
}

model Creator {
  id          String       @id @default(uuid())
  name        String
  userId      String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  user        UserProfile  @relation(fields: [userId], references: [id])
  competitors Competitor[]

  @@unique([userId, name])
}

model Watchlist {
  id          String       @id @default(uuid())
  name        String
  userId      String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  user        UserProfile  @relation(fields: [userId], references: [id])
  competitors Competitor[] @relation("CompetitorToWatchlist")

  @@unique([userId, name])
}

model CompetitorPost {
  id             String     @id @default(uuid())
  competitorId   String
  thumbnailUrl   String
  captionExcerpt String
  postedAt       DateTime
  metrics        Json
  isViral        Boolean    @default(false)
  analysis       Json?
  externalUrl    String? // Unique identifier from platform (e.g., video ID or URL)
  createdAt      DateTime   @default(now())
  competitor     Competitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)

  @@unique([competitorId, externalUrl])
}

model UserPost {
  id              String        @id @default(uuid())
  externalId      String?
  thumbnailUrl    String?
  caption         String?
  postedAt        DateTime
  metrics         Json
  socialAccountId String
  hookId          String?
  createdAt       DateTime      @default(now())
  hook            Hook?         @relation(fields: [hookId], references: [id])
  socialAccount   SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)
}

model Follower {
  id              String        @id @default(uuid())
  handle          String
  name            String?
  avatarUrl       String?
  segment         String
  stats           Json
  socialAccountId String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  socialAccount   SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)
  interactions    Interaction[]

  @@unique([socialAccountId, handle])
}

model Interaction {
  id         String   @id @default(uuid())
  followerId String
  type       String
  content    String?
  timestamp  DateTime @default(now())
  createdAt  DateTime @default(now())
  follower   Follower @relation(fields: [followerId], references: [id], onDelete: Cascade)
}

model SocialAccount {
  id           String       @id @default(uuid())
  userId       String
  platform     String
  username     String
  accountId    String
  avatarUrl    String?
  accessToken  String?
  refreshToken String?
  tokenExpiry  DateTime?
  isActive     Boolean      @default(false)
  isConnected  Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  automations  Automation[]
  competitors  Competitor[]
  followers    Follower[]
  hooks        Hook[]
  user         UserProfile  @relation(fields: [userId], references: [id], onDelete: Cascade)
  userPosts    UserPost[]

  @@unique([userId, platform, accountId])
}

model Automation {
  id                  String         @id @default(uuid())
  name                String
  triggerKeyword      String
  responseMessage     String
  platform            String?
  active              Boolean        @default(true)
  userId              String
  socialAccountId     String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  commentReplyEnabled Boolean        @default(false)
  commentReplyMessage String?
  lastRunAt           DateTime?
  runCount            Int            @default(0)
  instagramPostId     String?
  isGlobal            Boolean        @default(true)
  socialAccount       SocialAccount? @relation(fields: [socialAccountId], references: [id])
  user                UserProfile    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum ProjectType {
  GENERAL
  CASE_STUDY
  CONTENT_SERIES
  COLLABORATIVE
}

model Project {
  id          String        @id @default(uuid())
  name        String
  type        ProjectType   @default(GENERAL)
  description String?
  status      String        @default("Active")
  metadata    Json? // Type-specific global data
  userId      String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  user        UserProfile   @relation(fields: [userId], references: [id], onDelete: Cascade)
  items       ProjectItem[]
}

model ProjectItem {
  id        String   @id @default(uuid())
  projectId String
  type      String // e.g., "video", "episode", "note"
  title     String
  content   Json?
  status    String?
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

// ─── Community feed ──────────────────────────────────────────────────────────

enum UserRole {
  MEMBER
  INSTRUCTOR
  MODERATOR
  ADMIN
  SUPER_ADMIN
}

enum MemberStatus {
  ACTIVE
  MUTED
  SUSPENDED
  BANNED
}

// Who did what in the admin tools (role changes, restrictions, deletions…)
model AdminActivity {
  id          String       @id @default(uuid())
  actorId     String?
  action      String // e.g. "member.role_changed", "post.deleted"
  targetType  String // "member", "post", "comment"…
  targetId    String?
  targetLabel String? // readable snapshot, kept even if the target is deleted
  details     Json?
  createdAt   DateTime     @default(now())
  actor       UserProfile? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([targetType, targetId])
  @@map("admin_activity")
}

model CommunitySpace {
  id          String          @id @default(uuid())
  name        String
  emoji       String
  description String
  adminOnly   Boolean         @default(false) // only moderators/admins can post
  position    Int             @default(0)
  coverUrl    String?
  archivedAt  DateTime? // hidden from the space list and closed to new posts; old posts stay
  createdAt   DateTime        @default(now())
  posts       CommunityPost[]

  @@map("community_spaces")
}

model CommunityPost {
  id            String                @id @default(uuid())
  spaceId       String
  authorId      String
  title         String?
  content       String
  coverUrl      String?
  images        String[]
  pinned        Boolean               @default(false)
  // New members' first posts wait for review before others can see them
  reviewStatus  PostReviewStatus      @default(PUBLISHED)
  reviewedById  String?
  reviewedAt    DateTime?
  reviewNote    String?
  heldReason    String? // set when the flagged-words filter held the post (staff review only)
  editedAt      DateTime?
  editedByStaff Boolean               @default(false)
  deletedById   String?
  // Denormalized counters, kept in sync in the same transaction as the write
  likeCount     Int                   @default(0)
  commentCount  Int                   @default(0)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  deletedAt     DateTime?
  space         CommunitySpace        @relation(fields: [spaceId], references: [id])
  author        UserProfile           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  reviewedBy    UserProfile?          @relation("PostReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  likes         CommunityPostLike[]
  bookmarks     CommunityBookmark[]
  comments      CommunityComment[]
  pollOptions   CommunityPollOption[]
  pollVotes     CommunityPollVote[]
  reports       ContentReport[]

  @@index([deletedAt, pinned, createdAt])
  @@index([spaceId, deletedAt, pinned, createdAt])
  @@index([reviewStatus, createdAt])
  @@map("community_posts")
}

model CommunityPostLike {
  postId    String
  userId    String
  createdAt DateTime      @default(now())
  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      UserProfile   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
  @@map("community_post_likes")
}

model CommunityBookmark {
  postId    String
  userId    String
  createdAt DateTime      @default(now())
  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      UserProfile   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
  @@index([userId, createdAt])
  @@map("community_bookmarks")
}

model CommunityPollOption {
  id        String              @id @default(uuid())
  postId    String
  label     String
  position  Int
  voteCount Int                 @default(0)
  post      CommunityPost       @relation(fields: [postId], references: [id], onDelete: Cascade)
  votes     CommunityPollVote[]

  @@index([postId])
  @@map("community_poll_options")
}

model CommunityPollVote {
  postId    String
  userId    String
  optionId  String
  createdAt DateTime            @default(now())
  post      CommunityPost       @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      UserProfile         @relation(fields: [userId], references: [id], onDelete: Cascade)
  option    CommunityPollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  // One vote per member per poll
  @@id([postId, userId])
  @@map("community_poll_votes")
}

model CommunityComment {
  id            String          @id @default(uuid())
  postId        String
  authorId      String
  content       String
  createdAt     DateTime        @default(now())
  deletedAt     DateTime?
  deletedById   String?
  editedAt      DateTime?
  editedByStaff Boolean         @default(false)
  // Held by the flagged-words filter: only the author and staff see it until released
  heldReason    String?
  reports       ContentReport[]
  post          CommunityPost   @relation(fields: [postId], references: [id], onDelete: Cascade)
  author        UserProfile     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
  @@map("community_comments")
}

// ─── Joining (Phase 2a) ──────────────────────────────────────────────────────

enum PostReviewStatus {
  PENDING // waiting for review, only the author sees it
  PUBLISHED
  REJECTED
}

enum JoinStatus {
  PENDING // hasn't applied yet, or waiting for review
  APPROVED
  REJECTED
}

/**
 * Single row (id "default") with the community's joining rules.
 */
model CommunitySettings {
  id                 String   @id @default("default")
  requireApproval    Boolean  @default(true)
  requireRules       Boolean  @default(true)
  requireQuiz        Boolean  @default(false)
  quizPassPercent    Int      @default(80)
  probationPostCount Int      @default(3)
  guideVersion       Int      @default(0) // 0 = no guide published yet
  flaggedWords       String[] @default([])
  updatedAt          DateTime @updatedAt

  @@map("community_settings")
}

model MemberApplication {
  id            String       @id @default(uuid())
  userId        String       @unique
  fullName      String
  phone         String
  niche         String
  platforms     Json // [{ platform, handle }]
  followerRange String?
  about         String?
  inviteId      String?
  submittedAt   DateTime     @default(now())
  reviewedById  String?
  reviewedAt    DateTime?
  reviewNote    String? // shown to the applicant when rejected
  user          UserProfile  @relation("Applicant", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy    UserProfile? @relation("ApplicationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  invite        InviteLink?  @relation(fields: [inviteId], references: [id], onDelete: SetNull)

  @@index([submittedAt])
  @@map("member_applications")
}

model GuideSection {
  id        String   @id @default(uuid())
  position  Int
  title     String
  body      String // plain text with line breaks
  mediaUrl  String?
  updatedAt DateTime @updatedAt

  @@map("guide_sections")
}

model QuizQuestion {
  id           String   @id @default(uuid())
  position     Int
  question     String
  options      String[]
  correctIndex Int
  updatedAt    DateTime @updatedAt

  @@map("quiz_questions")
}

/**
 * Audit trail: every time a member accepted the rules, and which version.
 */
model RulesAcceptance {
  id         String      @id @default(uuid())
  userId     String
  version    Int
  acceptedAt DateTime    @default(now())
  user       UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, acceptedAt])
  @@map("rules_acceptances")
}

model InviteLink {
  id            String              @id @default(uuid())
  code          String              @unique
  label         String
  autoApprove   Boolean             @default(true)
  specialMember Boolean             @default(false)
  expiresAt     DateTime?
  maxUses       Int?
  useCount      Int                 @default(0)
  revokedAt     DateTime?
  createdById   String?
  createdAt     DateTime            @default(now())
  createdBy     UserProfile?        @relation(fields: [createdById], references: [id], onDelete: SetNull)
  applications  MemberApplication[]

  @@map("invite_links")
}

// ─── Moderation (Phase 3) ────────────────────────────────────────────────────

enum ReportReason {
  SPAM
  HARASSMENT
  HATE
  NSFW
  MISINFORMATION
  SELF_PROMOTION
  OTHER
}

enum ReportStatus {
  OPEN
  RESOLVED // action was taken
  DISMISSED // nothing wrong
}

/**
 * A member reporting a post or comment. One report per member per item.
 */
model ContentReport {
  id           String            @id @default(uuid())
  reporterId   String
  postId       String?
  commentId    String?
  reason       ReportReason
  note         String?
  status       ReportStatus      @default(OPEN)
  resolution   String? // what staff did, e.g. "removed + warned author"
  resolvedById String?
  resolvedAt   DateTime?
  createdAt    DateTime          @default(now())
  reporter     UserProfile       @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  resolvedBy   UserProfile?      @relation("ReportResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  post         CommunityPost?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  comment      CommunityComment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([reporterId, postId])
  @@unique([reporterId, commentId])
  @@index([status, createdAt])
  @@map("content_reports")
}

/**
 * A warning from staff, shown to the member until they acknowledge it.
 */
model MemberWarning {
  id         String       @id @default(uuid())
  userId     String
  issuedById String?
  reason     String
  createdAt  DateTime     @default(now())
  seenAt     DateTime?
  user       UserProfile  @relation("WarnedMember", fields: [userId], references: [id], onDelete: Cascade)
  issuedBy   UserProfile? @relation("WarningIssuer", fields: [issuedById], references: [id], onDelete: SetNull)

  @@index([userId, seenAt])
  @@map("member_warnings")
}

// ─── Access rules (Phase 4) ──────────────────────────────────────────────────

/**
 * Membership tiers such as Free and Pro. Exactly one is the default for members without a tier.
 */
model MembershipTier {
  id          String        @id
  name        String
  description String?
  position    Int           @default(0)
  isDefault   Boolean       @default(false)
  createdAt   DateTime      @default(now())
  members     UserProfile[]

  @@map("membership_tiers")
}

/**
 * Who can open a space (and later courses, events, challenges). All set
 * conditions must match; staff always have access. No row = open to everyone.
 */
model AccessRule {
  id           String    @id @default(uuid())
  resourceType String // "space", later "course", "event", "challenge"
  resourceId   String
  minRole      UserRole?
  tierIds      String[] // empty = any tier
  minDays      Int? // days since joining
  minLevel     Int?
  updatedAt    DateTime  @updatedAt

  @@unique([resourceType, resourceId])
  @@map("access_rules")
}

// ─── Events (Phase 5) ────────────────────────────────────────────────────────

enum EventStatus {
  DRAFT // only the host and staff see it
  PUBLISHED
  CANCELLED
}

enum EventLocationType {
  ONLINE
  IN_PERSON
}

model CommunityEvent {
  id           String            @id @default(uuid())
  title        String
  description  String            @default("")
  coverUrl     String?
  startsAt     DateTime
  endsAt       DateTime
  timezone     String // IANA zone the host chose, e.g. "Africa/Casablanca"
  locationType EventLocationType @default(ONLINE)
  location     String? // address or venue for in-person events
  link         String? // live link: only shown to members who are going, the host and staff
  category     String?
  capacity     Int? // null = unlimited
  status       EventStatus       @default(DRAFT)
  recordingUrl String?
  hostId       String
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  deletedAt    DateTime?
  host         UserProfile       @relation("EventHost", fields: [hostId], references: [id], onDelete: Cascade)
  rsvps        EventRsvp[]

  @@index([status, startsAt])
  @@map("community_events")
}

model EventRsvp {
  eventId   String
  userId    String
  createdAt DateTime       @default(now())
  event     CommunityEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      UserProfile    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([eventId, userId])
  @@map("event_rsvps")
}

// ─── Points, levels & badges (Phase 6) ───────────────────────────────────────

/**
 * Points per action, editable by admins. Negative points are penalties.
 */
model PointRule {
  action    String   @id // e.g. "POST_PUBLISHED"
  points    Int
  dailyCap  Int? // max points per member per day from this action; null = no cap
  enabled   Boolean  @default(true)
  updatedAt DateTime @updatedAt

  @@map("point_rules")
}

/**
 * Ledger of every scored action. One row per member, action and source, so an
 * action never scores twice and can be taken back (e.g. an unlike).
 */
model PointEvent {
  id         String      @id @default(uuid())
  userId     String
  action     String
  points     Int // can be 0 when the daily cap is reached; the action still counts for badges
  sourceType String? // "post", "comment", "event", "manual"…
  sourceId   String?
  note       String?
  createdAt  DateTime    @default(now())
  user       UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, action, sourceId])
  @@index([createdAt])
  @@index([userId, action])
  @@map("point_events")
}

model Level {
  level     Int    @id
  name      String
  minPoints Int

  @@map("levels")
}

model Badge {
  id          String        @id
  name        String
  emoji       String
  color       String        @default("#f59e0b")
  description String        @default("")
  // Automatic award: { "type": "POSTS" | "COMMENTS" | "LIKES_RECEIVED" | "EVENTS_JOINED" | "COURSES_COMPLETED" | "POINTS", "threshold": n }
  autoRule    Json?
  archivedAt  DateTime?
  createdAt   DateTime      @default(now())
  holders     MemberBadge[]
  courses     Course[] // courses that give this badge on completion

  @@map("badges")
}

model MemberBadge {
  badgeId     String
  userId      String
  awardedById String? // null = awarded automatically
  note        String?
  awardedAt   DateTime     @default(now())
  badge       Badge        @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  user        UserProfile  @relation("BadgeHolder", fields: [userId], references: [id], onDelete: Cascade)
  awardedBy   UserProfile? @relation("BadgeAwarder", fields: [awardedById], references: [id], onDelete: SetNull)

  @@id([badgeId, userId])
  @@map("member_badges")
}

// ─── Courses (Phase 7) ────────────────────────────────────────────────────────

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED // hidden from the catalogue; members who started keep access
}

enum LessonType {
  VIDEO
  TEXT
}

model Course {
  id                String             @id @default(uuid())
  title             String
  description       String             @default("")
  coverUrl          String?
  status            CourseStatus       @default(DRAFT)
  ownerId           String
  completionBadgeId String? // optional badge given when a member finishes the course
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  deletedAt         DateTime?
  owner             UserProfile        @relation("CourseOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  completionBadge   Badge?             @relation(fields: [completionBadgeId], references: [id], onDelete: SetNull)
  modules           CourseModule[]
  enrollments       CourseEnrollment[]

  @@index([status, createdAt])
  @@map("courses")
}

model CourseModule {
  id       String   @id @default(uuid())
  courseId String
  title    String
  position Int      @default(0)
  dripDays Int? // opens this many days after the member starts the course; null = right away
  course   Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons  Lesson[]

  @@index([courseId, position])
  @@map("course_modules")
}

model Lesson {
  id              String             @id @default(uuid())
  moduleId        String
  title           String
  type            LessonType         @default(VIDEO)
  videoUrl        String?
  content         String             @default("")
  durationMinutes Int?
  position        Int                @default(0)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  module          CourseModule       @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  attachments     LessonAttachment[]
  progress        LessonProgress[]

  @@index([moduleId, position])
  @@map("course_lessons")
}

/**
 * A link, or a file in the private course-files bucket (downloaded through short-lived signed URLs).
 */
model LessonAttachment {
  id          String  @id @default(uuid())
  lessonId    String
  name        String
  url         String?
  storagePath String?
  size        Int?
  position    Int     @default(0)
  lesson      Lesson  @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId, position])
  @@map("lesson_attachments")
}

model CourseEnrollment {
  courseId       String
  userId         String
  startedAt      DateTime    @default(now())
  lastLessonId   String?
  lastActivityAt DateTime    @default(now())
  completedAt    DateTime?
  course         Course      @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user           UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([courseId, userId])
  @@index([userId, lastActivityAt])
  @@map("course_enrollments")
}

model LessonProgress {
  lessonId    String
  userId      String
  courseId    String // kept for per-course counts
  completedAt DateTime    @default(now())
  lesson      Lesson      @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  user        UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([lessonId, userId])
  @@index([courseId, userId])
  @@map("lesson_progress")
}
