{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "yarn build"
  },
  "deploy": {
    "startCommand": "yarn start",
    "preDeployCommand": "yarn migrate:deploy",
    "healthcheckPath": "/health",
    "restartPolicyType": "ON_FAILURE"
  }
}
