generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// -- User Data (Synced with Clerk) --
model UserProfile {
  id        String   @id @default(uuid())
  clerkId   String   @unique
  email     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Relations
  hooks       Hook[]
  competitors Competitor[]
  socialAccounts SocialAccount[]
}

// -- Library (Hooks & Scripts) --
model Hook {
  id                String   @id @default(uuid())
  content           String
  type              String   // Verbal, Visual
  emotion           String
  topic             String
  performanceRating Int?     // 1-5
  
  // Usage Tracking
  usageCount        Int      @default(0)
  lastUsed          DateTime?
  
  userId            String
  user              UserProfile @relation(fields: [userId], references: [id])
  
  socialAccountId   String?
  socialAccount     SocialAccount? @relation(fields: [socialAccountId], references: [id])
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// -- Competitor Tracking --
model Competitor {
  id        String   @id @default(uuid())
  handle    String
  name      String
  avatarUrl String
  bio       String?
  tags      String[]
  
  // Snapshots of their stats
  stats     Json     // { followers: string, avgLikes: string, engagementRate: string }
  
  userId    String
  user      UserProfile @relation(fields: [userId], references: [id])
  
  socialAccountId String?
  socialAccount   SocialAccount? @relation(fields: [socialAccountId], references: [id])
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  posts     CompetitorPost[]
  
  @@unique([userId, handle]) // User can't track same competitor twice
}

// -- Viral Posts Analysis --
model CompetitorPost {
  id             String   @id @default(uuid())
  competitorId   String
  competitor     Competitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)
  
  thumbnailUrl   String
  captionExcerpt String
  postedAt       DateTime
  
  metrics        Json     // { likes: number, comments: number }
  isViral        Boolean  @default(false)
  
  // Analysis Data
  analysis       Json?    // { hook: string, structure: string, notes: string }
  
  createdAt      DateTime @default(now())
}

// -- Social Account Management --
model SocialAccount {
  id          String   @id @default(uuid())
  userId      String
  user        UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  platform    String   // 'instagram', 'tiktok', 'youtube', etc.
  username    String
  accountId   String   // Platform-specific ID
  avatarUrl   String?
  
  // OAuth / API Credentials
  accessToken String?  // Store encrypted in production
  refreshToken String?
  tokenExpiry DateTime?
  
  // Account Status
  isActive    Boolean  @default(false) // Currently selected account
  isConnected Boolean  @default(true)  // Connection is valid
  
  // Relations
  hooks       Hook[]
  competitors Competitor[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@unique([userId, platform, accountId]) // One user can't connect same account twice
}
